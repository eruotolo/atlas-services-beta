# Variables que consume docker-compose.yml (Compose lee ./.env automáticamente).
# Copiá este archivo como .env y completá los valores.
#
#   cp .env.example .env
#
# OJO: estas credenciales también viven dentro de DATABASE_URL en backend/.env.local
# cuando se corre el backend fuera de Docker. Dentro de Docker el compose las inyecta.

POSTGRES_USER=hireeo
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=db_hireeo
